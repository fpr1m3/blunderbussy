# Agent Opulence Environment Configuration
# Copy to .env and set values

# ═══════════════════════════════════════════════════════════════════════════
# Required Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Metasploit Framework (REQUIRED for C2)
MSF_USER=msf
MSF_PASS=your_secure_password_here

# Faraday Database
FARADAY_DB_PASSWORD=changeme
FARADAY_USER=faraday

# ═══════════════════════════════════════════════════════════════════════════
# Target Configuration (set per engagement)
# ═══════════════════════════════════════════════════════════════════════════

# HTB Target (for vhost resolution in hexstrike-recon)
HTB_TARGET=10.129.x.x
HTB_HOSTNAME=target.htb

# Workspace name for Faraday
TARGET_NAME=pentest

# ═══════════════════════════════════════════════════════════════════════════
# Optional Configuration
# ═══════════════════════════════════════════════════════════════════════════

# Artifacts directory (default: ./artifacts)
ARTIFACTS_PATH=./artifacts

# NVD API key for faster CVE lookups (optional but recommended)
# Get one at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# For payload callbacks - set to your VPN IP
# ═══════════════════════════════════════════════════════════════════════════
# Query VPN IP: curl http://localhost:9998/lhost (via pwncat-mcp)
# Or: podman exec gluetun ip -4 addr show tun0 | grep inet
LHOST=10.10.14.x
