{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${extensionPath}/hooks/session_start.py",
            "name": "session-state-loader",
            "description": "Load session state and inject memory block into context",
            "timeout": 10000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${extensionPath}/hooks/autorecon_dedup.py",
            "name": "autorecon-dedup",
            "description": "Block redundant scans that AutoRecon already completed",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "python3 ${extensionPath}/hooks/before_tool.py",
            "name": "query-cache-check",
            "description": "Check query cache for deduplication",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "python3 ${extensionPath}/hooks/shellcheck_validator.py",
            "name": "shellcheck-validator",
            "description": "Validate shell command syntax before execution",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${extensionPath}/hooks/after_tool.py",
            "name": "credential-extractor",
            "description": "Extract credentials from shell command output",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
