# Agent Opulence - Pwncat MCP Server
FROM python:3.11-slim

LABEL maintainer="Agent Opulence"
LABEL description="Pwncat-cs MCP interface for post-exploitation"

WORKDIR /app

# Install system dependencies for pwncat (netifaces needs libc-dev for stdlib.h)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libc-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pwncat-requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY pwncat-server.py server.py

ENV PYTHONUNBUFFERED=1
ENV PWNCAT_SOCKET=/tmp/pwncat.sock

# Create non-root user for security
# Socket directory needs to be writable by appuser
RUN useradd -r -u 1001 -g root appuser && \
    mkdir -p /tmp/pwncat && chown appuser:root /tmp/pwncat
ENV PWNCAT_SOCKET=/tmp/pwncat/pwncat.sock
USER appuser

CMD ["python3", "/app/server.py"]
