# Agent Opulence - Sliver C2 MCP Server
FROM python:3.11-slim

LABEL maintainer="Agent Opulence"
LABEL description="Sliver C2 MCP interface"

WORKDIR /app

COPY sliver-requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY sliver-server.py server.py

ENV PYTHONUNBUFFERED=1
ENV SLIVER_HOST=sliver
ENV SLIVER_PORT=31337

# Create non-root user for security
RUN useradd -r -u 1001 -g root appuser
USER appuser

CMD ["python3", "/app/server.py"]
