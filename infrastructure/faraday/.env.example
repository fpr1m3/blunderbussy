# =============================================================================
# Faraday Environment Configuration
# =============================================================================
# Copy this file to .env and configure your values before deployment:
#   cp .env.example .env
#
# SECURITY WARNING: Never commit .env files with real credentials to git!
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# PostgreSQL password for Faraday database
# REQUIRED: Change this to a strong, unique password
FARADAY_DB_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Server Configuration (currently in config/server.ini)
# -----------------------------------------------------------------------------

# Note: secret_key and agent_registration_secret are currently configured
# directly in config/server.ini. For production, consider externalizing these.

# -----------------------------------------------------------------------------
# Optional: CVE/Vulnerability Enrichment
# -----------------------------------------------------------------------------

# NVD API Key for faster CVE lookups and vulnerability enrichment
# Without an API key, requests are rate-limited to ~5 per 30 seconds
# With an API key, you get ~50 requests per 30 seconds
#
# Get your free API key from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

