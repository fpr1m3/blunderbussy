# =============================================================================
# Faraday Environment Configuration
# =============================================================================
# Copy this file to .env and configure your values before deployment:
#   cp .env.example .env
#
# SECURITY WARNING: Never commit .env files with real credentials to git!
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# PostgreSQL password for Faraday database
# REQUIRED: Change this to a strong, unique password
FARADAY_DB_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Secret key for session encryption and CSRF protection
# REQUIRED: Generate a secure random key before deployment
#
# Generate with one of these commands:
#   openssl rand -hex 32
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
FARADAY_SECRET_KEY=generate-a-secure-random-key

# -----------------------------------------------------------------------------
# Artifacts Configuration
# -----------------------------------------------------------------------------

# Path to mount scan results and artifacts from host
# This directory will be accessible inside the Faraday container
# Use absolute path or relative path from docker-compose.yml location
ARTIFACTS_PATH=./artifacts

# -----------------------------------------------------------------------------
# Optional: CVE/Vulnerability Enrichment
# -----------------------------------------------------------------------------

# NVD API Key for faster CVE lookups and vulnerability enrichment
# Without an API key, requests are rate-limited to ~5 per 30 seconds
# With an API key, you get ~50 requests per 30 seconds
#
# Get your free API key from: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# -----------------------------------------------------------------------------
# Optional: Server Settings
# -----------------------------------------------------------------------------

# Faraday server listening port (default: 5985)
# FARADAY_PORT=5985

# Faraday server listening address (default: 0.0.0.0)
# FARADAY_BIND_ADDRESS=0.0.0.0

# Enable debug mode (default: false, set to true for development only)
# FARADAY_DEBUG=false
