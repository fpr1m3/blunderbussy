{
  "mcpServers": {
    "opulence-artifacts": {
      "command": "python3",
      "args": ["infrastructure/mcp-servers/artifacts/server.py"],
      "env": {
        "OPULENCE_ARTIFACTS_DIR": "/artifacts"
      }
    },
    "opulence-manifest": {
      "command": "python3",
      "args": ["infrastructure/mcp-servers/manifest/server.py"],
      "env": {
        "OPULENCE_MANIFEST_DIR": "/manifest"
      }
    },
    "opulence-scope": {
      "command": "python3",
      "args": ["infrastructure/mcp-servers/scope/server.py"],
      "env": {
        "OPULENCE_SCOPE_DIR": "/scope"
      }
    }
  }
}
